{
  "name": "envoylens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server.js",
    "test": "node --test tests/*.test.js",
    "build:go": "npm run build && go build -trimpath -ldflags=\"-s -w\" -o bin/envoylens .",
    "test:go": "npm run build && go test ./..."
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9"
  }
}
